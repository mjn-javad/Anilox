# Copy these values into .env. Do not commit the real access token.
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com

# Instagram fetches post images from this public HTTPS address. Configure a
# reverse proxy or tunnel that forwards this URL to INSTAGRAM_MEDIA_PORT.
INSTAGRAM_MEDIA_PORT=8081
INSTAGRAM_MEDIA_PUBLIC_BASE_URL=https://your-public-domain.example
