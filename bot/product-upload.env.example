# Existing bot credentials
BOT_TOKEN=replace-with-telegram-bot-token
ADMIN_ID=123456789
TELEGRAM_BOT_SERVICE_KEY=replace-with-the-same-32-character-key-used-by-both-sites

# Existing Anilox variables remain supported for backward compatibility.
ANILOX_BRAND_API_URL=https://aniloxhub.com/api/v1/brandPopular
ANILOX_PRODUCT_API_URL=https://aniloxhub.com/api/v1/products/telegram

# EbrahaStyle uses the same multipart protocol and service key.
EBRAHA_BRAND_API_URL=https://ebrahastyle.com/api/v1/brandPopular
EBRAHA_PRODUCT_API_URL=https://ebrahastyle.com/api/v1/products/telegram
PRODUCT_IMAGE_FIELD=images

# Telegram Mini App. Point this HTTPS URL through a reverse proxy to MINI_APP_PORT.
# The path may be changed; the server derives its route from this URL.
MINI_APP_PUBLIC_URL=https://your-domain.example/product-upload
MINI_APP_PORT=8082
